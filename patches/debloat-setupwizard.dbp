# Hide User Experience, skip Lenovo ID and EasySync, and keep Home usable.

name = "debloat-setupwizard"
description = "Hide the non-functional User Experience row, skip the Lenovo ID entry screen and removed XuiEasySync restore activity, and keep the final home button visible without the Vantage widget."

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZUISetupWizardExtPRC/ZUISetupWizardExtPRC.apk"
scan_class = "Lcom/zui/setupwizard/ZuiUtils;"
scan_method = "getCloudActivityAction"
target_class = "Lcom/zui/setupwizard/utils/ConnectivityUtil;"
target_method = "isOnline"
proto = "(Landroid/content/Context;)Z"
value = false

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZUISetupWizardExtPRC/ZUISetupWizardExtPRC.apk"
scan_class = "Lcom/zui/setupwizard/ZuiUtils;"
scan_method = "getCloudActivityAction"
target_class = "Lcom/tblenovo/setup/utils/SharedPreHelper;"
target_method = "isCloudRestoreCompleted"
proto = "(Landroid/content/Context;)Z"
value = true

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZUISetupWizardExtPRC/ZUISetupWizardExtPRC.apk"
class = "Lcom/zui/setupwizard/PrivacyAndSettingActivity;"
method = "initView"
proto = "()V"

[[op.symbol]]
name = "user_experience_row"
kind = "field"
class = "Lcom/zui/setupwizard/PrivacyAndSettingActivity;"
field = "mUserExperience"
ty = "Landroid/widget/RelativeLayout;"

[[op.symbol]]
name = "row_click"
kind = "method"
class = "Landroid/widget/RelativeLayout;"
method = "setOnClickListener"
proto = "(Landroid/view/View$OnClickListener;)V"

[[op.symbol]]
name = "set_visibility"
kind = "method"
class = "Landroid/view/View;"
method = "setVisibility"
proto = "(I)V"

[[op.replacement]]
from = "54 53 ${user_experience_row:u16} 38 03 05 00 6e 20 ${row_click:u16} 53 00"
to = "54 53 ${user_experience_row:u16} 13 04 08 00 6e 20 ${set_visibility:u16} 43 00"

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZUISetupWizardExtPRC/ZUISetupWizardExtPRC.apk"
class = "Lcom/zui/setupwizard/PrivacyAndSettingActivity;"
method = "initView"
proto = "()V"

[[op.symbol]]
name = "user_experience_row"
kind = "field"
class = "Lcom/zui/setupwizard/PrivacyAndSettingActivity;"
field = "mUserExperience"
ty = "Landroid/widget/RelativeLayout;"

[[op.symbol]]
name = "row_click"
kind = "method"
class = "Landroid/widget/RelativeLayout;"
method = "setOnClickListener"
proto = "(Landroid/view/View$OnClickListener;)V"

[[op.symbol]]
name = "set_visibility"
kind = "method"
class = "Landroid/view/View;"
method = "setVisibility"
proto = "(I)V"

[[op.replacement]]
from = "54 50 ${user_experience_row:u16} 38 00 05 00 6e 20 ${row_click:u16} 50 00"
to = "54 50 ${user_experience_row:u16} 13 04 08 00 6e 20 ${set_visibility:u16} 40 00"

[[op]]
kind = "field_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
scan_class = "Lcom/lenovo/settings/wifi/DeviceActivationForWifiActivity;"
scan_method = "startPrivacySettingsActivity"
target_class = "Lcom/lenovo/settings/wifi/DeviceActivationForWifiActivity;"
target_field = "isNetworkAvail"
value = true

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
scan_class = "Lcom/lenovo/settings/wifi/DeviceActivationForWifiActivity;"
scan_method = "startPrivacySettingsActivity"
target_class = "Lcom/lenovo/settings/wifi/DeviceActivationForWifiActivity;"
target_method = "isPrcCommercial"
value = false

[[op]]
kind = "intent_action_broadcast"
partition = "system"
file = "system/priv-app/LenovoID/LenovoID.apk"
from_action = "com.zui.cloudservice.intent.action.GUIDE_DATA_RESTORE_FROM_PRIVACY"
to_action = "com.zui.setupwizard.action.CLOUD_SKIP"

[[op]]
kind = "method_broadcast_finish"
partition = "system"
file = "system/priv-app/LenovoID/LenovoID.apk"
class = "Lcom/lenovo/lsf/lenovoid/ui/PsLoginWizardActivity;"
method = "onCreate"
proto = "(Landroid/os/Bundle;)V"
super_class = "Lcom/lenovo/lsf/lenovoid/ui/BaseWizardActivity;"
action = "com.zui.setupwizard.action.CLOUD_SKIP"

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZUISetupWizardExtPRC/ZUISetupWizardExtPRC.apk"
scan_class = "Lcom/zui/setupwizard/CompleteLandActivity;"
scan_method = "onCreate"
target_class = "Lcom/zui/setupwizard/common/AppHelper;"
target_method = "isSupportCCS"
value = true

# onEnterEnd checks the same gate again after the page transition. Keep it out
# of the legacy FloatWindowService path, whose hidden button waits for a removed
# launcher-widget broadcast.
[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZUISetupWizardExtPRC/ZUISetupWizardExtPRC.apk"
scan_class = "Lcom/zui/setupwizard/CompleteLandActivity;"
scan_method = "onEnterEnd"
target_class = "Lcom/zui/setupwizard/common/AppHelper;"
target_method = "isSupportCCS"
value = true
