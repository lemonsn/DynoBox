
name = "unlock-wifi"
description = "Use the US Wi-Fi region and keep the translator on CN."

[[op]]
kind = "text_replace"
partition = "system"
file = "system/build.prop"
from = "ro.config.zui.education=true\n"
to = "ro.product.countrycode=US\n##\n"

[[op]]
kind = "text_replace"
partition = "system"
file = "system/bin/init"
from = "ro.product.countrycode"
to = "ro.product.countrycodE"

[[op]]
kind = "method_const_string"
partition = "system"
file = "system/priv-app/LeVoiceCaptionApp/LeVoiceCaptionApp.apk"
class = "Lcom/zui/translator/utils/MicrosoftApiKey;"
method = "getCountryCode"
proto = "()Ljava/lang/String;"
value = "CN"
