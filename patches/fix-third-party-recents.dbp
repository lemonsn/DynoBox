to = "6e 10 ${sb_to_string:u16} 00 00 0c 00 71 20 ${log_d:u16} 02 00"

# Mirror the finishInner before-hook. The entry jumps into a second code cave
# made from the removed OVF debug message. Only a "requested" finish whose
# toHome argument conflicts with the controller's normal, non-empty pausing
# state is rewritten to false. The Xposed module's PackageManager lookup is
# intentionally omitted: the internal inconsistency is the actual fault
# signature and needs no new dex ids or code units.
[[op]]
kind = "method_code_patch"
partition = "system_ext"
# Same image-root path as enable-circle-to-search.dbp.
file = "priv-app/ZuiSystemUI/ZuiSystemUI.apk"
class = "Lcom/android/wm/shell/recents/RecentsTransitionHandler$RecentsController;"
method = "finishInner"
proto = "(ZZLcom/android/internal/os/IResultReceiver;Ljava/lang/String;)V"

[[op.symbol]]
name = "is_gesture"
kind = "field"
class = "Lcom/android/wm/shell/recents/RecentsTransitionHandler$RecentsController;"
