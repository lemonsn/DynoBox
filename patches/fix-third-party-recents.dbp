1a 08 ${to_overview_log:u16} 6e 20 ${sb_append_string:u16} 87 00 6e 20 ${sb_append_bool:u16} 67 00 1a 08 ${window_progress_log:u16}
6e 20 ${sb_append_string:u16} 87 00 52 38 ${last_window_progress:u16} 6e 20 ${sb_append_float:u16} 87 00 1a 08 ${long_swipe_log:u16}
6e 20 ${sb_append_string:u16} 87 00 55 38 ${long_swipe_full_to_freeform:u16} 6e 20 ${sb_append_bool:u16} 87 00 1a 08 ${switch_task_log:u16}
6e 20 ${sb_append_string:u16} 87 00 55 38 ${is_switch_new_task_freeform:u16} 6e 20 ${sb_append_bool:u16} 87 00 6e 10 ${sb_to_string:u16}
07 00 0c 07 1a 08 ${gesture_helper_tag:u16} 71 20 ${slog_d:u16} 78 00
"""
to = """
29 00 39 00 08 06 1b 00 1b 03 ${requested:u32} 6e 20 ${object_equals:u16} 63 00
0a 03 38 03 17 00 38 00 15 00 55 13 ${will_finish_to_home:u16} 39 03 11 00 52 13
${state:u16} 39 03 0d 00 54 13 ${pausing_tasks:u16} 38 03 09 00 6e 10 ${array_list_is_empty:u16} 03 00
0a 03 39 03 03 00 12 00 55 13 ${is_gesture:u16} 1a 08 ${gesture_helper_tag:u16}
29 00 c7 ff 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
"""

# Port the ZuiLauncher hook into RecentsActivity.M()V. RecentsActivity is
# the fallback overview used when Home and Overview differ. Query the existing
# ActivityManagerWrapper for the current top task: keep startHome for a missing
# task, a HOME task, or RecentsActivity itself; otherwise suppress the stale
# startHome callback that steals focus after launching a third-party app.
#
# The allowed path intentionally calls the existing startHomeIntentSafely
# overload with a null Bundle. The Xposed hook would proceed through the OEM
# RemoteTransition setup, but that animation wrapper cannot coexist with the
# guard inside this fixed 52-code-unit body. Functional Home navigation remains;
# only the OEM remote animation is omitted on this fallback path.
# Symbolic DEX references keep the body portable when pool layouts move.
[[op]]
kind = "method_code_patch"
partition = "system"
# Same image-root path as debloat-launcher.dbp.
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
class = "Lcom/android/quickstep/RecentsActivity;"
method = "M"
proto = "()V"

[[op.symbol]]
name = "launcher_animation_runner_type"
kind = "type"
descriptor = "Lcom/android/launcher3/LauncherAnimationRunner;"

[[op.symbol]]
name = "get_main_thread_handler"
kind = "method"
class = "Landroid/app/Activity;"
method = "getMainThreadHandler"
proto = "()Landroid/os/Handler;"

[[op.symbol]]
name = "remote_animation_factory"
kind = "field"
class = "Lcom/android/quickstep/RecentsActivity;"
