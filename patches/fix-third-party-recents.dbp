54 55 ${task_animator:u16} 6e 10 ${cancel_animator:u16} 05 00
"""
to = """
29 00 fe fe 5b 64 ${prev_visible_freeforms:u16} 38 04 08 00 6e 10 ${array_list_is_empty:u16} 04 00 0a 01
38 01 0d 00 5b 60 ${launcher_state:u16} 0e 00
"""

[[op.replacement]]
from = "6e 51 ${hide_all_tasks:u16} 05 23"
to = "6e 51 ${hide_all_tasks:u16} 45 23"

[[op.replacement]]
from = "1a 00 ${overview_log:u16} 71 20 ${log_d:u16} 01 00"
to = "1a 00 ${overview_log:u16} 71 20 ${log_d:u16} 05 00"

[[op.replacement]]
from = "1a 00 ${home_log:u16} 71 20 ${log_d:u16} 01 00"
to = "1a 00 ${home_log:u16} 71 20 ${log_d:u16} 05 00"

[[op.replacement]]
