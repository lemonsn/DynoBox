name = "fix-third-party-recents"
description = "Fix SystemUI and ZuiLauncher Recents transitions with a third-party default launcher."

# Mirror ZuiRecentsFix's GoingToOverview guard inside the OEM synthetic
# Consumer body shape whose removed entry log supplies an animator-cancel code
# cave. Subsequent replacements route the
# GoingToOverview branch through an ArrayList.isEmpty() guard: an empty list
# records prevVisibleFreeforms + mLauncherState and returns, while a non-empty
# list rejoins the byte-identical OEM hideAllTasks path. The final three
# replacements give each surviving debug call a path-correct String tag after
# the original tag-initializing prologue becomes the code cave.
[[op]]
kind = "method_code_patch"
partition = "system_ext"
# Same image-root path as enable-circle-to-search.dbp.
file = "priv-app/ZuiSystemUI/ZuiSystemUI.apk"
class = "Lcom/android/wm/shell/recents/RecentTasksController$$ExternalSyntheticLambda6;"
method = "accept"
proto = "(Ljava/lang/Object;)V"

[[op.symbol]]
name = "string_builder_type"
kind = "type"
descriptor = "Ljava/lang/StringBuilder;"

[[op.symbol]]
name = "state_log"
kind = "string"
value = "OvHangingModeController#OvHangingModeController - state:"

